# ============================================================
# Application
# ============================================================

APP_NAME=kafkastarter
APP_VERSION=1.0.0
APP_PORT=8080
SERVER_CONTEXT_PATH=/kafkastarter

# ============================================================
# MySQL
# ============================================================
MYSQL_DATABASE=kafkastarter
MYSQL_USER=kafkastarter
MYSQL_PASSWORD=kafkastarter
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306

SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/kafkastarter
SPRING_DATASOURCE_USERNAME=kafkastarter
SPRING_DATASOURCE_PASSWORD=kafkastarter

SPRING_JPA_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_DIALECT=org.hibernate.dialect.MySQLDialect
SPRING_JPA_FORMAT_SQL=true

# ============================================================
# Kafka
# ============================================================
KAFKA_NODE_ID=1
KAFKA_BROKER_PORT=9092
KAFKA_CONTROLLER_PORT=9093

KAFKA_REPLICATION_FACTOR=1
KAFKA_DEFAULT_REPLICATION_FACTOR=1
KAFKA_NUM_PARTITIONS=1

KAFKA_CLUSTER_NAME=local

SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ============================================================
# Kafka Streams
# ============================================================
KAFKA_STREAMS_APPLICATION_ID=product-catalog-aggregator-v1
KAFKA_STREAMS_AUTO_OFFSET_RESET=earliest
KAFKA_STREAMS_NUM_THREADS=1
KAFKA_STREAMS_REPLICATION_FACTOR=1

KAFKA_PROCESSING_GUARANTEE=exactly_once_v2

KAFKA_SPECIFIC_AVRO_READER=true
# ============================================================
# Schema Registry
# ============================================================
SCHEMA_REGISTRY_PORT=8081
SCHEMA_REGISTRY_HOST_NAME=schema-registry
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# ============================================================
# Kafka UI
# ============================================================
KAFKA_UI_PORT=8090

# ============================================================
# SonarQube
# ============================================================
SONAR_PORT=9000

SONAR_DB_PORT=5432
SONAR_JDBC_DATABASE=sonarqube
SONAR_JDBC_USERNAME=sonarqube
SONAR_JDBC_PASSWORD=sonarqube

# ============================================================
# Prometheus
# ============================================================

PROMETHEUS_PORT=9090

# ============================================================
# Grafana
# ============================================================
GRAFANA_PORT=3000

# ============================================================
# Logging
# ============================================================
SPRING_LOG_LEVEL_KAFKA_STREAMS=INFO
SPRING_LOG_LEVEL_SPRING_KAFKA=INFO